    "import numpy as np\n",
    "\n",
    "A = np.array([\n",
    "    [2, 3, 1, 5],\n",
    "    [4, 7, 7, 17],\n",
    "    [-2, 4, 5, 10],\n",
    "    [6, 18, 22, 61]\n",
    "], dtype=float)\n",
    "\n",
    "def lu_doolittle(A):\n",
    "    n = A.shape[0]\n",
    "    L = np.zeros((n, n))\n",
    "    U = np.zeros((n, n))\n",
    "\n",
    "    for i in range(n):\n",
    "        # Diagonal L = 1\n",
    "        L[i, i] = 1\n",
    "\n",
    "        # Menghitung elemen U\n",
    "        for j in range(i, n):\n",
    "            U[i, j] = A[i, j] - sum(L[i, k] * U[k, j] for k in range(i))\n",
    "\n",
    "        # Menghitung elemen L\n",
    "        for j in range(i + 1, n):\n",
    "            L[j, i] = (A[j, i] - sum(L[j, k] * U[k, i] for k in range(i))) / U[i, i]\n",
    "\n",
    "    return L, U\n",
    "\n",
    "L, U = lu_doolittle(A)\n",
    "\n",
    "print(\"Matriks A:\")\n",
    "print(A)\n",
    "\n",
    "print(\"\\nMatriks L:\")\n",
    "print(L)\n",
    "\n",
    "print(\"\\nMatriks U:\")\n",
    "print(U)\n",
    "\n",
    "A_rekonstruksi = L @ U\n",
    "\n",
    "print(\"\\nHasil perkalian L @ U:\")\n",
    "print(A_rekonstruksi)\n",
    "\n",
    "print(\"\\nApakah A = L @ U?\")\n",
    "print(np.allclose(A, A_rekonstruksi))\n"
   ]
